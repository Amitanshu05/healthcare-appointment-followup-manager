# =========================================================================
# CareSync Hospital Appointment Manager - Environment Variables Configuration Template
# =========================================================================
# Copy this file to '.env' and fill in your actual credentials.
# Never commit your active '.env' file containing real secrets to GitHub!

# 1. PostgreSQL Database Configurations (Used by Docker Compose & Spring Boot)
POSTGRES_DB=hospital_appointment_db_tkf4
POSTGRES_USER=hospital_appointment_db_tkf4_user
POSTGRES_PASSWORD=your_secure_postgres_db_password
DATABASE_URL=jdbc:postgresql://localhost:5432/hospital_appointment_db_tkf4

# 2. Asynchronous SMTP Mail Configurations (Gmail / Mailgun / Resend)
SMTP_USERNAME=your_gmail_or_smtp_login_email@gmail.com
# Use a 16-character App Password for Gmail SMTP rather than your account login password
SMTP_PASSWORD=your_smtp_app_password

# 3. Gemini AI Clinical Analysis Configurations
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere1234567

# 4. Google Calendar API OAuth Credentials
GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_oauth_client_secret_here

# 5. Production Host Parameters
RENDER_EXTERNAL_DB_URL=jdbc:postgresql://your-postgres-host.oregon-postgres.render.com/hospital_appointment_db_tkf4?sslmode=require
VERCEL_FRONTEND_URL=https://healthcare-manager-pi.vercel.app
RENDER_BACKEND_URL=https://healthcare-manager-9.onrender.com
